# Publish source, scripts, documentation and dependency/configuration files.
# Run payloads, downloaded papers and generated artifacts remain local.
*
!*/
!*.py
!*.sh
!*.bash
!*.md
!*.rst
!*.tex
!*.bib
!*.toml
!*.yaml
!*.yml
!requirements*.txt
!*-requirements.txt
!dependency-lock-or-export.txt
!USAGE.txt
!uv.lock
!.gitignore
!.gitattributes
!Makefile
!justfile
!LICENSE*
!**/configs/**/*.json

# Local state, environments and credentials (always excluded).
.optmem/
.agents/
.aws/
.codex/
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
*.pem
*.key
id_ed25519*
id_rsa*
*api_key*
*api_token*
/papers/
/credit_hedging/runs/

# Generated run copies and embedded artifacts externalized from Python scripts.
.external-payloads/
runs/
source_snapshots/
checkpoints/
submitted-job.py
effective-submitted-job.py
*.pkl
*.pickle
*.eqx
*.npz
*.npy
*.ckpt
*.pt
*.pth
*.safetensors
